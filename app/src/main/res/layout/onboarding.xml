<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboarding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC080B14"
    android:clickable="true"
    android:visibility="gone">

    <dev.raj.lucerra.GlassFrame
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="34dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/obDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:orientation="horizontal" />

            <FrameLayout
                android:id="@+id/obStage"
                android:layout_width="match_parent"
                android:layout_height="96dp">

                <ImageView
                    android:id="@+id/obIcon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/obKey"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:background="@drawable/avatar_bg"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/obName"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/menu_row"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:hint="@string/ob_name_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="16"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#80FFFFFF"
                    android:textSize="22sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/obAvatars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/obTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/obBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.15"
                android:minLines="3"
                android:textColor="#D9FFFFFF"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/obBack"
                    style="@style/DockButton"
                    android:layout_marginEnd="12dp"
                    android:text="@string/ob_back" />

                <TextView
                    android:id="@+id/obNext"
                    style="@style/DockButton" />

                <TextView
                    android:id="@+id/obSkip"
                    style="@style/DockButton"
                    android:layout_marginStart="12dp"
                    android:text="@string/ob_skip" />
            </LinearLayout>
        </LinearLayout>
    </dev.raj.lucerra.GlassFrame>
</FrameLayout>
