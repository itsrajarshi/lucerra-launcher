<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <dev.rajarshi.glasshome.WallpaperView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Home: 5% overscan-safe margins (48dp of 960dp). -->
    <FrameLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="48dp"
        android:paddingTop="27dp"
        android:paddingEnd="48dp"
        android:paddingBottom="27dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:orientation="vertical">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.18"
                android:shadowColor="#660B0F14"
                android:shadowRadius="6"
                android:textColor="#D9FFFFFF"
                android:textSize="11sp" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-light"
                android:format12Hour="EEEE d MMMM"
                android:format24Hour="EEEE d MMMM"
                android:shadowColor="#660B0F14"
                android:shadowRadius="8"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp" />
        </LinearLayout>

        <!-- Time + profile pill. Focusable only in full-screen mode (Up from the shelf, then Up again). -->
        <dev.rajarshi.glasshome.GlassFrame
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:padding="3dp">

            <LinearLayout
                android:id="@+id/btnProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/dock_btn"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="5dp"
                android:paddingBottom="4dp">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:format12Hour="h:mm a"
                    android:format24Hour="HH:mm"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/avatarInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/avatar_bg"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </dev.rajarshi.glasshome.GlassFrame>

        <LinearLayout
            android:id="@+id/bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="6dp"
                android:drawableTop="@drawable/ic_chevron_up"
                android:drawablePadding="2dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:shadowColor="#B30B0F14"
                android:shadowRadius="8"
                android:text="@string/hint_fullscreen"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/appName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:shadowColor="#660B0F14"
                android:shadowRadius="10"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp" />

            <!-- The shelf: one glass surface holding the favourites. -->
            <dev.rajarshi.glasshome.GlassFrame
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:padding="10dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDock"
                    android:layout_width="match_parent"
                    android:layout_height="106dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </dev.rajarshi.glasshome.GlassFrame>
        </LinearLayout>
    </FrameLayout>

    <!-- All Apps sheet: slides up from the shelf, goes back down on Back. -->
    <FrameLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <dev.rajarshi.glasshome.GlassFrame
            android:id="@+id/sheetGlass"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:clipChildren="false"
            android:paddingStart="12dp"
            android:paddingTop="18dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.18"
                android:text="@string/all_apps"
                android:textAllCaps="true"
                android:textColor="#D9FFFFFF"
                android:textSize="11sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="22dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="24dp" />
        </dev.rajarshi.glasshome.GlassFrame>
    </FrameLayout>
</FrameLayout>
