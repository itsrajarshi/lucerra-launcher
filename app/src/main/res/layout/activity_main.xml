<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <dev.rajarshi.glasshome.WallpaperView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Home: 5% overscan-safe margins (48dp of 960dp). -->
    <FrameLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="48dp"
        android:paddingTop="27dp"
        android:paddingEnd="48dp"
        android:paddingBottom="27dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:orientation="vertical">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.18"
                android:shadowColor="#99000000"
                android:shadowRadius="10"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-light"
                android:format12Hour="EEEE d MMMM"
                android:format24Hour="EEEE d MMMM"
                android:shadowColor="#99000000"
                android:shadowRadius="10"
                android:textColor="#FFFFFFFF"
                android:textSize="30sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="6dp"
                android:drawableTop="@drawable/ic_chevron_up"
                android:drawablePadding="2dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:shadowColor="#B30B0F14"
                android:shadowRadius="8"
                android:text="@string/hint_all_apps"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/appName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:shadowColor="#99000000"
                android:shadowRadius="12"
                android:textColor="#FFFFFFFF"
                android:textSize="30sp" />

            <!-- The shelf: one glass surface holding the favourites. -->
            <dev.rajarshi.glasshome.GlassFrame
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:padding="10dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDock"
                    android:layout_width="match_parent"
                    android:layout_height="106dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="7dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </dev.rajarshi.glasshome.GlassFrame>
        </LinearLayout>
    </FrameLayout>

    <!-- All Apps: full-screen glass; pinned apps in a dark strip on top, everything else below. -->
    <FrameLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <dev.rajarshi.glasshome.GlassFrame
            android:id="@+id/sheetGlass"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <!-- Deeper tint than the shelf: this is a whole screen of glass. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#730B0F14" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="48dp"
                android:paddingTop="80dp"
                android:paddingEnd="48dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.18"
                        android:text="@string/all_apps"
                        android:textAllCaps="true"
                        android:textColor="#F2FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/pin_hint"
                        android:textColor="#CCFFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/strip_bg"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:padding="10dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvPinned"
                        android:layout_width="match_parent"
                        android:layout_height="95dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingStart="7dp" />
                </FrameLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvGrid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="14dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="10dp"
                    android:paddingBottom="27dp" />
            </LinearLayout>
        </dev.rajarshi.glasshome.GlassFrame>
    </FrameLayout>

        <!-- Assistant bubble + time/profile pill, top right. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="27dp"
            android:layout_marginEnd="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <dev.rajarshi.glasshome.GlassFrame
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/btnAssistant"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Google Assistant"
                    android:focusable="true"
                    android:background="@drawable/focus_oval"
                    android:src="@drawable/ic_assistant" />
            </dev.rajarshi.glasshome.GlassFrame>

    <dev.rajarshi.glasshome.GlassFrame
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="3dp">
    
                <LinearLayout
                    android:id="@+id/btnProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/focus_pill"
                android:clickable="true"
                android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="5dp">
    
                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:format12Hour="h:mm a"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="20sp" />
    
                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="12dp">
    
                        <TextView
                            android:id="@+id/avatarInitial"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/avatar_bg"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:textColor="#FFFFFFFF"
                            android:textSize="16sp" />
    
                        <ImageView
                            android:id="@+id/avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>
        </dev.rajarshi.glasshome.GlassFrame>
    </LinearLayout>
</FrameLayout>
