<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <dev.rajarshi.glasshome.WallpaperView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Home: 5% overscan-safe margins (48dp of 960dp). -->
    <FrameLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="48dp"
        android:paddingTop="27dp"
        android:paddingEnd="48dp"
        android:paddingBottom="27dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:orientation="vertical">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.18"
                android:textColor="#D9FFFFFF"
                android:textSize="11sp" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:letterSpacing="-0.03"
                android:textColor="#FFFFFFFF"
                android:textSize="48sp" />
        </LinearLayout>

        <!-- Glass pills: functional controls, so they get the material. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:orientation="horizontal">

            <dev.rajarshi.glasshome.GlassFrame
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="3dp">

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/DockButton"
                    android:text="@string/wifi" />
            </dev.rajarshi.glasshome.GlassFrame>

            <dev.rajarshi.glasshome.GlassFrame
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:padding="3dp">

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/DockButton"
                    android:text="@string/settings" />
            </dev.rajarshi.glasshome.GlassFrame>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/appName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp" />

            <!-- The shelf: one glass surface holding the favourites. -->
            <dev.rajarshi.glasshome.GlassFrame
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:padding="10dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDock"
                    android:layout_width="match_parent"
                    android:layout_height="106dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </dev.rajarshi.glasshome.GlassFrame>
        </LinearLayout>
    </FrameLayout>

    <!-- All Apps sheet: slides up from the shelf, goes back down on Back. -->
    <FrameLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <dev.rajarshi.glasshome.GlassFrame
            android:id="@+id/sheetGlass"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:clipChildren="false"
            android:paddingStart="12dp"
            android:paddingTop="18dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.18"
                android:text="@string/all_apps"
                android:textAllCaps="true"
                android:textColor="#D9FFFFFF"
                android:textSize="11sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="22dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="24dp" />
        </dev.rajarshi.glasshome.GlassFrame>
    </FrameLayout>
</FrameLayout>
